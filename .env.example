# Open-source local Whisper model with cross-attention word timestamps (cached on first use).
KAPTIO_WHISPER_MODEL=onnx-community/whisper-base_timestamped
# Optional persistent cache location; defaults to .cache/huggingface in the project.
KAPTIO_MODEL_CACHE=
# Optional shared access token for API routes when deploying publicly.
KAPTIO_API_TOKEN=
# Optional paths if you prefer a system FFmpeg installation.
FFMPEG_PATH=
FFPROBE_PATH=

{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "kaptio",
  "main": "cloudflare/worker.ts",
  "compatibility_date": "2026-10-18",
  "containers": [
    {
      "class_name": "KaptioContainer",
      "image": "./Dockerfile",
      "instance_type": "standard-1",
      "max_instances": 1
    }
  ],
  "durable_objects": {
    "bindings": [
      {
        "name": "KAPTIO_CONTAINER",
        "class_name": "KaptioContainer"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["KaptioContainer"]
    }
  ],
  "workers_dev": true,
  "observability": {
    "enabled": true
  }
}
